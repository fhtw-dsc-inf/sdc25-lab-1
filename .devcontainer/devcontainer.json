// .devcontainer/devcontainer.json
{
  "name": "Python 3.11 + uv (on mcr image)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",    
        "ms-python.vscode-python-envs"     
      ],
    }
  },

  "onCreateCommand": "pip install uv && uv venv --clear && uv pip install -r requirements.txt",

  "updateContentCommand": "pip install uv && uv venv --clear && uv pip install -r requirements.txt",
}
